{
  "$schema": "https://raw.githubusercontent.com/jamestryand/eventmodelschema/main/schema/eventmodeling.schema.json",
  "eventModelingSchemaVersion": "4.1.0",
  "id": "subscription-renewal",
  "name": "Subscription Renewal",
  "description": "A worked example for the eventmodeling skill: a renewal check that carries today's date and the payment processor's answer, guarded against deadlines the stream already holds.",
  "swimlanes": [
    {
      "id": "billing",
      "name": "Billing",
      "kind": "team"
    }
  ],
  "actorLanes": {
    "operator": {
      "name": "Operator"
    }
  },
  "events": {
    "subscription-started": {
      "name": "Subscription Started",
      "description": "A subscription began, or began again after it lapsed.",
      "swimlaneId": "billing",
      "aggregate": "subscription",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "paidUntil",
          "type": "integer"
        },
        {
          "name": "status",
          "type": "string"
        }
      ]
    },
    "renewal-paid": {
      "name": "Renewal Paid",
      "description": "The processor says the subscription is paid to a later date.",
      "swimlaneId": "billing",
      "aggregate": "subscription",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "paidUntil",
          "type": "integer"
        },
        {
          "name": "status",
          "type": "string"
        }
      ]
    },
    "renewal-failed": {
      "name": "Renewal Failed",
      "description": "The period ended unpaid. Grace runs until graceEnds; the stream keeps that date so a later check can compare with it.",
      "swimlaneId": "billing",
      "aggregate": "subscription",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "graceEnds",
          "type": "integer"
        },
        {
          "name": "status",
          "type": "string"
        }
      ]
    },
    "subscription-lapsed": {
      "name": "Subscription Lapsed",
      "description": "Grace ended and the subscription is still unpaid.",
      "swimlaneId": "billing",
      "aggregate": "subscription",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "status",
          "type": "string"
        }
      ]
    }
  },
  "commands": {
    "start-subscription": {
      "name": "Start Subscription",
      "description": "Start a subscription: the first one, or a new one after a lapse.",
      "reason": "A first payment, or a payment after a lapse, gives access.",
      "aggregate": "subscription",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string"
        },
        {
          "name": "paidUntil",
          "type": "integer"
        }
      ],
      "refuseWhen": [
        {
          "message": "already subscribed",
          "all": [
            {
              "state": "status",
              "equals": "Active"
            }
          ]
        },
        {
          "message": "already subscribed",
          "all": [
            {
              "state": "status",
              "equals": "Grace"
            }
          ]
        }
      ]
    },
    "record-renewal-check": {
      "name": "Record Renewal Check",
      "description": "What the processor says when a period or a grace period ends, with today's date (yyyymmdd). A decider cannot read the clock, so the date arrives here.",
      "reason": "Nobody lapses without the processor being asked first.",
      "aggregate": "subscription",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string"
        },
        {
          "name": "today",
          "type": "integer"
        },
        {
          "name": "paidUntil",
          "type": "integer"
        },
        {
          "name": "graceEnds",
          "type": "integer",
          "optional": true,
          "description": "When grace would end if this check finds the period unpaid; worked out by the sender from the grace setting."
        }
      ],
      "refuseWhen": [
        {
          "message": "already lapsed",
          "all": [
            {
              "state": "status",
              "equals": "Lapsed"
            }
          ]
        },
        {
          "message": "period not over",
          "all": [
            {
              "state": "status",
              "equals": "Active"
            },
            {
              "command": "today",
              "atMost": {
                "state": "paidUntil"
              }
            }
          ]
        },
        {
          "message": "grace not over",
          "all": [
            {
              "state": "status",
              "equals": "Grace"
            },
            {
              "command": "paidUntil",
              "atMost": {
                "state": "paidUntil"
              }
            },
            {
              "command": "today",
              "atMost": {
                "state": "graceEnds"
              }
            }
          ]
        },
        {
          "message": "graceEnds is needed when a renewal fails",
          "all": [
            {
              "state": "status",
              "equals": "Active"
            },
            {
              "command": "paidUntil",
              "atMost": {
                "state": "paidUntil"
              }
            },
            {
              "command": "graceEnds",
              "is": "notSet"
            }
          ]
        }
      ]
    }
  },
  "readModels": {
    "subscription-status": {
      "name": "Subscription Status",
      "question": "Where does this subscription stand, and until when?",
      "builtFromEventIds": [
        "subscription-started",
        "renewal-paid",
        "renewal-failed",
        "subscription-lapsed"
      ],
      "requiredRole": "operator",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "status",
          "type": "string"
        },
        {
          "name": "paidUntil",
          "type": "integer"
        },
        {
          "name": "graceEnds",
          "type": "integer",
          "optional": true
        }
      ]
    },
    "subscriptions-in-grace": {
      "name": "Subscriptions In Grace",
      "question": "Which subscriptions are in grace, and when does each grace end?",
      "builtFromEventIds": [
        "renewal-failed",
        "renewal-paid",
        "subscription-lapsed",
        "subscription-started"
      ],
      "removedByEventIds": [
        "renewal-paid",
        "subscription-lapsed",
        "subscription-started"
      ],
      "requiredRole": "operator",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "graceEnds",
          "type": "integer"
        }
      ]
    }
  },
  "screens": {
    "subscriptions-screen": {
      "name": "Subscriptions",
      "actorLaneId": "operator"
    }
  },
  "slices": [
    {
      "id": "start-subscription-slice",
      "name": "Start Subscription",
      "pattern": "stateChange",
      "swimlaneId": "billing",
      "status": "created",
      "screenId": "subscriptions-screen",
      "commandId": "start-subscription",
      "eventIds": [
        "subscription-started"
      ],
      "outcomes": [
        {
          "eventIds": [
            "subscription-started"
          ],
          "set": {
            "subscription-started": {
              "status": "Active"
            }
          }
        }
      ],
      "scenarios": [
        {
          "id": "a-first-payment-starts-a-subscription",
          "name": "A first payment starts a subscription",
          "kind": "stateChange",
          "given": [],
          "when": {
            "commandId": "start-subscription",
            "data": {
              "subscriptionId": "s-1",
              "paidUntil": 20261201
            }
          },
          "then": {
            "events": [
              {
                "eventId": "subscription-started",
                "data": {
                  "subscriptionId": "s-1",
                  "paidUntil": 20261201,
                  "status": "Active"
                }
              }
            ]
          }
        },
        {
          "id": "a-lapsed-subscription-can-start-again",
          "name": "A lapsed subscription can start again",
          "kind": "stateChange",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            },
            {
              "eventId": "subscription-lapsed",
              "data": {
                "subscriptionId": "s-1",
                "status": "Lapsed"
              }
            }
          ],
          "when": {
            "commandId": "start-subscription",
            "data": {
              "subscriptionId": "s-1",
              "paidUntil": 20271201
            }
          },
          "then": {
            "events": [
              {
                "eventId": "subscription-started",
                "data": {
                  "subscriptionId": "s-1",
                  "paidUntil": 20271201,
                  "status": "Active"
                }
              }
            ]
          }
        },
        {
          "id": "starting-twice-is-refused",
          "name": "Starting a running subscription again is refused",
          "kind": "error",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            }
          ],
          "when": {
            "commandId": "start-subscription",
            "data": {
              "subscriptionId": "s-1",
              "paidUntil": 20261201
            }
          },
          "then": {
            "error": {
              "message": "already subscribed"
            }
          }
        }
      ]
    },
    {
      "id": "record-renewal-check-slice",
      "name": "Record Renewal Check",
      "pattern": "stateChange",
      "swimlaneId": "billing",
      "status": "created",
      "screenId": "subscriptions-screen",
      "commandId": "record-renewal-check",
      "eventIds": [
        "renewal-paid",
        "renewal-failed",
        "subscription-lapsed"
      ],
      "outcomes": [
        {
          "eventIds": [
            "renewal-paid"
          ],
          "when": [
            {
              "all": [
                {
                  "command": "paidUntil",
                  "greaterThan": {
                    "state": "paidUntil"
                  }
                }
              ]
            }
          ],
          "set": {
            "renewal-paid": {
              "status": "Active"
            }
          }
        },
        {
          "eventIds": [
            "renewal-failed"
          ],
          "when": [
            {
              "all": [
                {
                  "state": "status",
                  "equals": "Active"
                }
              ]
            }
          ],
          "set": {
            "renewal-failed": {
              "status": "Grace"
            }
          }
        },
        {
          "eventIds": [
            "subscription-lapsed"
          ],
          "set": {
            "subscription-lapsed": {
              "status": "Lapsed"
            }
          }
        }
      ],
      "scenarios": [
        {
          "id": "a-period-not-over-is-not-due",
          "name": "A check before the period ends is refused",
          "kind": "error",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261120,
              "paidUntil": 20261201
            }
          },
          "then": {
            "error": {
              "message": "period not over"
            }
          }
        },
        {
          "id": "a-paid-renewal-moves-the-period-on",
          "name": "The processor says the renewal was paid",
          "kind": "stateChange",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261202,
              "paidUntil": 20271201
            }
          },
          "then": {
            "events": [
              {
                "eventId": "renewal-paid",
                "data": {
                  "subscriptionId": "s-1",
                  "paidUntil": 20271201,
                  "status": "Active"
                }
              }
            ]
          }
        },
        {
          "id": "an-unpaid-period-starts-grace",
          "name": "An unpaid period starts grace, and the stream keeps its end",
          "kind": "stateChange",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261202,
              "paidUntil": 20261201,
              "graceEnds": 20261209
            }
          },
          "then": {
            "events": [
              {
                "eventId": "renewal-failed",
                "data": {
                  "subscriptionId": "s-1",
                  "graceEnds": 20261209,
                  "status": "Grace"
                }
              }
            ]
          }
        },
        {
          "id": "an-unpaid-period-needs-a-grace-end",
          "name": "An unpaid check without a grace end is refused",
          "kind": "error",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261202,
              "paidUntil": 20261201
            }
          },
          "then": {
            "error": {
              "message": "graceEnds is needed when a renewal fails"
            }
          }
        },
        {
          "id": "grace-not-over-is-not-due",
          "name": "A check during grace is refused",
          "kind": "error",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261205,
              "paidUntil": 20261201
            }
          },
          "then": {
            "error": {
              "message": "grace not over"
            }
          }
        },
        {
          "id": "a-late-payment-during-grace-is-recovered",
          "name": "A payment found during grace ends grace",
          "kind": "stateChange",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261205,
              "paidUntil": 20271201
            }
          },
          "then": {
            "events": [
              {
                "eventId": "renewal-paid",
                "data": {
                  "subscriptionId": "s-1",
                  "paidUntil": 20271201,
                  "status": "Active"
                }
              }
            ]
          }
        },
        {
          "id": "grace-over-and-unpaid-lapses",
          "name": "Grace over and still unpaid: the subscription lapses",
          "kind": "stateChange",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261209,
              "paidUntil": 20261201
            }
          },
          "then": {
            "events": [
              {
                "eventId": "subscription-lapsed",
                "data": {
                  "subscriptionId": "s-1",
                  "status": "Lapsed"
                }
              }
            ]
          }
        },
        {
          "id": "a-repeated-check-after-lapse-is-refused",
          "name": "A repeated check after a lapse is refused, and the sender treats that as done",
          "kind": "error",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            },
            {
              "eventId": "subscription-lapsed",
              "data": {
                "subscriptionId": "s-1",
                "status": "Lapsed"
              }
            }
          ],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261210,
              "paidUntil": 20261201
            }
          },
          "then": {
            "error": {
              "message": "already lapsed"
            }
          }
        },
        {
          "id": "no-subscription-no-check",
          "name": "A check for a subscription that never started is refused",
          "kind": "error",
          "given": [],
          "when": {
            "commandId": "record-renewal-check",
            "data": {
              "subscriptionId": "s-1",
              "today": 20261202,
              "paidUntil": 20261201
            }
          },
          "then": {
            "error": {
              "message": "subscription does not exist"
            }
          }
        }
      ]
    },
    {
      "id": "see-subscription-status-slice",
      "name": "See Subscription Status",
      "pattern": "stateView",
      "swimlaneId": "billing",
      "status": "created",
      "screenId": "subscriptions-screen",
      "readModelId": "subscription-status",
      "scenarios": [
        {
          "id": "status-shows-grace-and-its-end",
          "name": "A subscription in grace shows when grace ends",
          "kind": "stateView",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            },
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-2",
                "paidUntil": 20261201,
                "status": "Active"
              }
            }
          ],
          "when": {
            "readModelId": "subscription-status",
            "queryParams": {
              "subscriptionId": "s-1"
            }
          },
          "then": {
            "result": {
              "subscriptionId": "s-1",
              "status": "Grace",
              "paidUntil": 20261201,
              "graceEnds": 20261208
            }
          }
        }
      ]
    },
    {
      "id": "see-subscriptions-in-grace-slice",
      "name": "See Subscriptions In Grace",
      "pattern": "stateView",
      "swimlaneId": "billing",
      "status": "created",
      "screenId": "subscriptions-screen",
      "readModelId": "subscriptions-in-grace",
      "scenarios": [
        {
          "id": "grace-lists-each-unpaid-subscription",
          "name": "Every subscription in grace is listed",
          "kind": "stateView",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            },
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-2",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-2",
                "graceEnds": 20261210,
                "status": "Grace"
              }
            }
          ],
          "when": {
            "readModelId": "subscriptions-in-grace"
          },
          "then": {
            "result": {
              "rows": [
                {
                  "subscriptionId": "s-1",
                  "graceEnds": 20261208
                },
                {
                  "subscriptionId": "s-2",
                  "graceEnds": 20261210
                }
              ]
            }
          }
        },
        {
          "id": "a-paid-renewal-leaves-the-grace-list",
          "name": "A paid renewal removes the row; the other stays",
          "kind": "stateView",
          "given": [
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-1",
                "graceEnds": 20261208,
                "status": "Grace"
              }
            },
            {
              "eventId": "subscription-started",
              "data": {
                "subscriptionId": "s-2",
                "paidUntil": 20261201,
                "status": "Active"
              }
            },
            {
              "eventId": "renewal-failed",
              "data": {
                "subscriptionId": "s-2",
                "graceEnds": 20261210,
                "status": "Grace"
              }
            },
            {
              "eventId": "renewal-paid",
              "data": {
                "subscriptionId": "s-1",
                "paidUntil": 20271201,
                "status": "Active"
              }
            }
          ],
          "when": {
            "readModelId": "subscriptions-in-grace"
          },
          "then": {
            "result": {
              "rows": [
                {
                  "subscriptionId": "s-2",
                  "graceEnds": 20261210
                }
              ]
            }
          }
        },
        {
          "id": "a-lapse-leaves-the-grace-list",
          "name": "A lapse removes the row too",
          "kind": "stateView",
          "given": [
